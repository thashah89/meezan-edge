# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT SECRETS — for your machine only.
# This file is in .gitignore and will NEVER be pushed to GitHub.
#
# Fill in your values below after you receive your Zerodha API approval.
# On Streamlit Cloud, enter these same keys in:
#   App Settings → Secrets  (NOT in this file)
# ─────────────────────────────────────────────────────────────────────────────

# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
ZERODHA_API_KEY      = ""       # e.g. "abc123xyz456"
ZERODHA_API_SECRET   = ""       # e.g. "aBcDeFgHiJkLmNoPqRsTuV"

# Set this to your Streamlit Cloud URL once deployed, e.g.:
# "https://yourname-meezan-edge.streamlit.app"
# Keep as 127.0.0.1 for local testing only.
ZERODHA_REDIRECT_URL = "http://127.0.0.1:8501"

# Leave blank unless you have a public server for order notifications.
ZERODHA_POSTBACK_URL = ""
